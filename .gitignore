# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# interaction frame-rate profiling harness output (measured, machine-specific)
/scripts/performance/.frame-profile-report.json

# lighthouse ci
/.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-dev*.log
/tmp/
/artifacts/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare
.open-next/
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / tooling
/.idea/
/.impeccable/
/.kiro/settings/
/.claude/settings.local.json

# supabase cli temp
/supabase/.temp/

# stray output files
/nul
/out.txt
/slug.txt
