NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (Resend). Required for password reset & email verification.
# Without RESEND_API_KEY, sendEmail() short-circuits and NO email is sent, even
# though the UI still shows a success message (anti-enumeration by design).
# Get a key at https://resend.com/api-keys. RESEND_FROM_EMAIL must use a domain
# verified in Resend (SPF/DKIM), otherwise Resend rejects the send.
# Verify config any time with: npm run email:check
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
LOG_LEVEL=info
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
TURNSTILE_SECRET_KEY=
