NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transactional email (Resend). Required for password reset & email verification.
# Without RESEND_API_KEY, sendEmail() short-circuits and NO email is sent, even
# though the UI still shows a success message (anti-enumeration by design).
# Get a key at https://resend.com/api-keys. RESEND_FROM_EMAIL must use a domain
# verified in Resend (SPF/DKIM), otherwise Resend rejects the send.
# Verify config any time with: npm run email:check
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
LOG_LEVEL=info
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
TURNSTILE_SECRET_KEY=
# Paystack secret key for rental deposits. Leave empty to keep deposits off.
# The same key verifies webhooks at /api/payments/paystack/webhook.
PAYSTACK_SECRET_KEY=
# A live key (sk_live_...) is refused unless this is "enabled". Set it only after the
# go-live checklist in docs/deposit-payments-proposal.md is done.
PAYSTACK_LIVE_PAYMENTS=
# Pinpoint Assistant (customer search). Leave the key empty to run on rules only.
OPENROUTER_API_KEY=
# Main model, then up to two fallbacks, comma-separated.
ASSISTANT_AI_MODELS=nvidia/nemotron-3.5-super-vl:free
# "deny" routes only to providers that don't store prompts. The free NVIDIA endpoint logs
# prompts, so it is only reachable with "allow".
OPENROUTER_DATA_COLLECTION=deny
# Swipe feed: "off" (default), "preview" (only with ?feed=1) or "on". See .kiro/specs/swipe-feed.
SWIPE_FEED=off
