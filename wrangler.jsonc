{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "roomza",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://roomza.pinpoint-roomza.workers.dev",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qleeedwnnfvmfjjymoco.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFsZWVlZHdubmZ2bWZqanltb2NvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc4NDg5MjQsImV4cCI6MjA5MzQyNDkyNH0.4LGGJvB7paU3L5sPRVCjQVZOgwLAR9OJDEt4N9Qqxj8",
    "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyDnl8C7j8NKPPCONLzhhw0p88sZb_tEOYE"
  }
  // Environment variables:
  // - NEXT_PUBLIC_* vars must be set at BUILD time (not runtime)
  //   so they get inlined. Set them in .env.local before building.
  // - Server-only secrets are set via: npx wrangler secret put <KEY>
}
