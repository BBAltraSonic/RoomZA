  "environment": "disposable patched local clone; private atomic decision RPC checks; no deployment",
  "tag": "pinpoint-decisions-c364745e-8128-436d-b530-95a9de258883",
  "checks": [
    {
      "name": "Anonymous/service and every aal1 actor denied approval, unpublication and decision read"
    },
    {
      "name": "Real admin MFA cannot approve without exact poster/permission/location evidence, final attestation and current offer version"
    },
    {
      "name": "Newer evidence and actual catalogue drift block approval with HTTP409 and no mutation"
    },
    {
      "name": "Same-token poster/reviewer revocation and poster suspension cannot approve"
    },
    {
      "name": "Concurrent identical approval creates one actual-actor/evidence audit and atomically increments version/clears pending; altered retry denied"
    },
    {
      "name": "Private decisions table/direct RPC revokes and privileged immutable trigger enforced"
    },
    {
      "name": "Private save leaves confirmed revision intact; a retry cannot ignore an intervening version change"
    },
    {
      "name": "Material submission invalidates in original intake transaction; rejection never restores earlier approval or permits delayed reapproval"
    },
    {
      "name": "Owner needs two actual verified TOTP factors; competing reviewers serialize with one approval and one 409"
    },
    {
      "name": "Unpublication requires current version/private reason, can remove inactive-poster approval, deduplicates and cannot restore old revision"
    },
    {
      "name": "Approval/withdrawal race has one winner; explicit current-version withdrawal removes approval and delayed retries cannot revive it"
    },
    {
      "name": "Approval retry/material-submission race always ends hidden with fresh pending revision and immutable invalidation"
    },
    {
      "name": "Actual clock expiry blocks approval with paused schedules and leaves pending version unchanged"
    }
  ],
