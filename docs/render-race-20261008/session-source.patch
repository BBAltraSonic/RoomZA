@@ -0,0 +1,27 @@
+// @vitest-environment jsdom
+import { act, cleanup, renderHook } from "@testing-library/react";
+import { afterEach, describe, expect, it } from "vitest";
+import { useLatestRead } from "./use-latest-read";
+afterEach(cleanup);
+describe("read ownership", () => {
+  it("aborts earlier reads, even when transport ignores cancellation", () => {
+    const { result, unmount } = renderHook(() => useLatestRead("scope"));
+    const old = result.current();
+    const current = result.current();
+    expect(old.signal.aborted).toBe(true);
+    expect(current.signal.aborted).toBe(false);
+    unmount();
+    expect(current.signal.aborted).toBe(true);
+    expect(result.current().signal.aborted).toBe(true);
+  });
+  it("rejects a stale callback after scope navigation", () => {
+    const { result, rerender } = renderHook(({scope}) => useLatestRead(scope), { initialProps: { scope: "old" } });
+    const beginOld = result.current;
+    const old = beginOld();
+    act(() => rerender({scope:"new"}));
+    expect(old.signal.aborted).toBe(true);
+    const current = result.current();
+    expect(beginOld().signal.aborted).toBe(true);
+    expect(current.signal.aborted).toBe(false);
+  });
+});
diff --git a/src/lib/hooks/use-latest-read.ts b/src/lib/hooks/use-latest-read.ts
index e69de29..0a975ec 100644
--- /dev/null
+++ b/src/lib/hooks/use-latest-read.ts
@@ -0,0 +1,24 @@
+"use client";
+import { useCallback, useEffect, useRef } from "react";
+
+/** Supersession and scope cleanup remain effective even after response headers arrive. */
+export function useLatestRead(scope: string) {
+  const requestRef = useRef<AbortController | null>(null);
+  const mounted = useRef(false);
+  const activeScope = useRef(scope);
+  useEffect(() => {
+    mounted.current = true;
+    activeScope.current = scope;
+    return () => { mounted.current = false; requestRef.current?.abort(); requestRef.current = null; };
+  }, [scope]);
+  return useCallback(() => {
+    const controller = new AbortController();
+    if (!mounted.current || activeScope.current !== scope) {
+      controller.abort();
+      return controller;
+    }
+    requestRef.current?.abort();
+    requestRef.current = controller;
+    return controller;
+  }, [scope]);
+}
