{
  "name": "roomza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/performance/check-first-load-js-budget.mjs && node scripts/performance/check-initial-js-budget.mjs",
    "budget:first-load-js": "node scripts/performance/check-first-load-js-budget.mjs",
    "profile:frames": "tsx scripts/performance/profile-interaction-frames.ts",
    "budget:initial-js": "node scripts/performance/check-initial-js-budget.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/ci/run-test-stage.mjs --stage vitest -- vitest run --testTimeout=120000 --hookTimeout=120000",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/ci/run-test-stage.mjs --stage playwright -- playwright test",
    "test:load": "k6 run scripts/load/listings-smoke.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --audit-level=moderate --omit=dev",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate-seed": "tsx scripts/db/generate-seed.ts",
    "email:check": "node scripts/ops/check-email.mjs",
    "admin:bootstrap": "node --env-file=.env.local --import tsx scripts/admin/bootstrap-owner.ts",
    "admin:recover": "node --env-file=.env.local --import tsx scripts/admin/recover-owner.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@googlemaps/markerclusterer": "2.6.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.105.1",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vis.gl/react-google-maps": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.31.0",
    "motion": "13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.20.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.6.0",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
