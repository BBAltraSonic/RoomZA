{
  "name": "roomza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/performance/check-first-load-js-budget.mjs && node scripts/performance/check-initial-js-budget.mjs",
    "budget:first-load-js": "node scripts/performance/check-first-load-js-budget.mjs",
    "profile:frames": "tsx scripts/performance/profile-interaction-frames.ts",
    "budget:initial-js": "node scripts/performance/check-initial-js-budget.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/ci/run-test-stage.mjs --stage vitest -- vitest run --testTimeout=120000 --hookTimeout=120000",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/ci/run-test-stage.mjs --stage playwright -- playwright test",
    "test:load": "k6 run scripts/load/listings-smoke.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --audit-level=moderate --omit=dev",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate-seed": "tsx scripts/db/generate-seed.ts",
    "email:check": "node scripts/ops/check-email.mjs",
    "admin:bootstrap": "node --env-file=.env.local --import tsx scripts/admin/bootstrap-owner.ts",
    "admin:recover": "node --env-file=.env.local --import tsx scripts/admin/recover-owner.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@googlemaps/markerclusterer": "2.6.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.105.1",
    "@upstash/qstash": "^2.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jszip": "3.10.1",
    "lucide-react": "^1.14.0",
    "motion": "12.42.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.1",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "shadcn": "^4.18.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^7",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
