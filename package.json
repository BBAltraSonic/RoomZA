{
  "name": "roomza",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ops/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ops/copy-maplibre-worker.mjs",
    "build": "next build --webpack && node scripts/performance/check-first-load-js-budget.mjs && node scripts/performance/check-initial-js-budget.mjs",
    "budget:first-load-js": "node scripts/performance/check-first-load-js-budget.mjs",
    "profile:frames": "tsx scripts/performance/profile-interaction-frames.ts",
    "budget:initial-js": "node scripts/performance/check-initial-js-budget.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/ci/run-test-stage.mjs --stage vitest -- vitest run --testTimeout=120000 --hookTimeout=120000",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/ci/run-test-stage.mjs --stage playwright -- playwright test",
    "test:load": "k6 run scripts/load/listings-smoke.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --audit-level=moderate --omit=dev",
    "prepreview:cf": "node scripts/ops/copy-maplibre-worker.mjs",
    "preview:cf": "opennextjs-cloudflare build && node scripts/ops/minify-cloudflare-server.mjs && node scripts/ops/prepare-discovery-assets.mjs && opennextjs-cloudflare preview",
    "cf:check:size": "wrangler deploy --dry-run --outdir .wrangler/worker-size && node scripts/ops/check-cloudflare-worker-size.mjs",
    "predeploy:cf": "node scripts/ops/copy-maplibre-worker.mjs",
    "deploy:cf": "opennextjs-cloudflare build && node scripts/ops/minify-cloudflare-server.mjs && node scripts/ops/prepare-discovery-assets.mjs && npm run cf:check:size && node scripts/ops/with-cloudflare-network.mjs wrangler deploy --config workers/discovery-api/wrangler.jsonc --keep-vars && node scripts/ops/with-cloudflare-network.mjs opennextjs-cloudflare deploy -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "discovery:api:build": "node scripts/ops/build-discovery-api.mjs",
    "db:generate-seed": "tsx scripts/db/generate-seed.ts",
    "email:check": "node scripts/ops/check-email.mjs",
    "admin:bootstrap": "node --env-file=.env.local --import tsx scripts/admin/bootstrap-owner.ts",
    "admin:recover": "node --env-file=.env.local --import tsx scripts/admin/recover-owner.ts",
    "test:notifications:db": "node scripts/db/verify-notifications.mjs",
    "notifications:worker:typecheck": "tsc --project workers/notifications/tsconfig.json --noEmit",
    "notifications:worker:check": "wrangler deploy --dry-run --config workers/notifications/wrangler.jsonc --outdir .cache/notifications-worker-build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@block65/webcrypto-web-push": "^2.0.0",
    "@maptiler/client": "^3.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@upstash/qstash": "^2.12.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.38.0",
    "@zip.js/zip.js": "2.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jszip": "3.10.2",
    "lucide-react": "^1.76.0",
    "maplibre-gl": "6.19.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-dropzone": "20.2.1",
    "react-hook-form": "7.92.0",
    "react-map-gl": "8.1.3",
    "react-markdown": "^10.1.0",
    "read-excel-file": "9.3.20",
    "remark-gfm": "^4.0.1",
    "resend": "^6.39.0",
    "saxes": "6.0.0",
    "sonner": "^2.0.8",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.1",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@faker-js/faker": "^10.5.0",
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/papaparse": "5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "shadcn": "^4.6.0",
    "supabase": "^2.109.0",
    "tailwindcss": "^4",
    "terser": "5.48.0",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
